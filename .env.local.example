# Copy to .env.local and fill in real values. Never commit .env.local.

# Auth.js session encryption key. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Pins Auth.js's own canonical origin instead of letting it infer one from
# request headers. Without this, running behind any proxy/port-forwarder
# (or even just binding the dev server wide with --hostname 0.0.0.0) can
# make Auth.js build an inconsistent origin across the sign-in request vs.
# the OAuth callback request, breaking the PKCE code_verifier cookie's
# round trip — Google then rejects the token exchange with a generic
# "doesn't comply with Google's OAuth 2.0 policy" error. Must match
# whatever URL you actually type into the browser (see run.sh's WEB_PORT).
AUTH_URL=http://localhost:3027

# Dedicated Google OAuth client for THIS app only, from
# https://console.cloud.google.com/apis/credentials. Required "Authorized
# redirect URI" on this client:
#   http://localhost:3027/api/auth/callback/google
# auth.ts uses Auth.js's default env var names for the Google provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL of the rune-registry backend — a separate repo/service (see
# ../rune_skills, a sibling checkout by convention). Used server-side only
# for the auth.ts <-> POST /api/v1/auth/google exchange.
RUNE_API_URL=http://127.0.0.1:8027

# The backend's runectl serve process must be started with the SAME Google
# client id, so it validates ID tokens against the right audience. This
# repo's own run.sh reads AUTH_GOOGLE_ID from this file automatically and
# exports it to the backend subprocess it starts — no separate copy needed
# here, and no reaching into the backend repo's files either.
