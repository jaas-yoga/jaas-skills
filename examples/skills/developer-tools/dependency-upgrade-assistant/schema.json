{
  "inputs": {
    "type": "object",
    "properties": {
      "package": {
        "type": "string",
        "description": "Name of the dependency to upgrade."
      },
      "targetVersion": {
        "type": "string",
        "description": "Target version, or 'latest'.",
        "default": "latest"
      }
    },
    "required": ["package"]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "fromVersion": { "type": "string" },
      "toVersion": { "type": "string" },
      "testsPassed": { "type": "boolean" },
      "breakingChangesNoted": {
        "type": "array",
        "items": { "type": "string" }
      },
      "followUps": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["fromVersion", "toVersion", "testsPassed"]
  }
}
